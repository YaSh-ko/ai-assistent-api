# Скопируйте в .env — только локальная разработка.
# API на хосте → localhost / host.docker.internal (если API в Docker).

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=db_for_delez
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_postgres
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_postgres@localhost:5433/db_for_delez

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_local_neo4j

REDIS_HOST=localhost
REDIS_PORT=6379

BETTER_AUTH_SECRET=change_me_min_32_chars
JWT_ISSUER=impulse-api

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

APP_NAME="Impulse API (Local)"
DEBUG=True
LOG_LEVEL=DEBUG
API_PORT=8001

# JWT RS256 — свои ключи
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=

# Email — опционально для локалки
# EmailConfiguration__From=noreply@example.com

# Telegram Bot — подтверждение записи на бета-тест
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=ImpulseBetaBot
# TELEGRAM_WEBHOOK_SECRET=random_secret_for_webhook
# TELEGRAM_ADMIN_CHAT_ID=123456789
#   ↑ узнать: напишите боту /myid после /start
# TELEGRAM_USE_POLLING=true
#   ↑ для локалки без webhook; на проде — false и setWebhook
