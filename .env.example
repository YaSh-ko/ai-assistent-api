# PostgreSQL
# ВАЖНО: Не используйте хардкод IP адресов в коде!
# Задавайте через переменные окружения для безопасности

# PostgreSQL
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=philosophy_staging
POSTGRES_USER=Admin_delezDB_psql
POSTGRES_PASSWORD=your_postgres_password

# Neo4j
NEO4J_URI=bolt://neo4j.your-domain.ru:7687
NEO4J_USER=your_neo4j_user
NEO4J_PASSWORD=your_neo4j_password

# Или используйте полный DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# Auth
BETTER_AUTH_SECRET=your_secret_key_here_min_32_chars
# JWT сессии (RS256): PEM целиком; для многострочного ключа в одной строке используйте \\n
# JWT_ISSUER=delez-api
# JWT_LEEWAY_SECONDS=120
# JWT_AUDIENCE=  # опционально; если задано — в токене будет aud и строгая проверка
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"

# Email (SMTP для Mail.ru)
# ВАЖНО: Пароль должен быть получен из безопасного источника!
EmailConfiguration__From=delez.ai@mail.ru
EmailConfiguration__SmtpServer=smtp.mail.ru
EmailConfiguration__Port=587
EmailConfiguration__Username=delez.ai@mail.ru
EmailConfiguration__Password=your_email_password_here

# CORS
CORS_ORIGINS=https://delez.tech,http://localhost:3000,http://127.0.0.1:3000
# Можно задать как JSON строку или через запятую
# CORS_ORIGINS=["https://delez.tech", "http://localhost:3000"]
# Или:
# CORS_ORIGINS=https://delez.tech,http://localhost:3000,http://127.0.0.1:3000

# SonarQube (никогда не коммитьте реальный токен; задавайте в .env локально или в CI)
# Получите токен в SonarQube: My Account → Security → Generate Token
SONARQUBE_TOKEN=your_sonarqube_token_here